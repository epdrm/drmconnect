# Variáveis de ambiente para o DRMConnect
# Copie este arquivo para .env e preencha com seus valores

# Supabase (obrigatório)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anonima-aqui"

# Avatar padrão (opcional - tem fallback no código)
VITE_AVATAR_PADRAO="https://seu-projeto.supabase.co/storage/v1/object/public/perfilFotoDefault/avatar-padrao.jpg"